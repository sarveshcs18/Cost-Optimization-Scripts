PROJECT_ID="hbl-uat-banking-ai-prj-4d"
REGION="asia-south1"

# Service Account and Workflow configurations
SERVICE_ACCOUNT="service-account-name"
WORKFLOW_NAME="infra-cost-optimizer"
WORKFLOW_FILE="workflow.yaml"
TIMEZONE="Asia/Kolkata"

# 11 PM Mon-Fri
STOP_CRON="30 22 * * 1-5"
# 8 AM Mon-Fri
START_CRON="0 8 * * 1-5"

# VM Target Labels
VM_LABEL_KEY="auto-shutdown"
VM_LABEL_VALUE="true"

# GKE Targets (JSON Array string)
GKE_TARGETS='[
  {"cluster": "cluster1", "nodepool": "pool1", "min_nodes": 1, "max_nodes": 5},
  {"cluster": "cluster2", "nodepool": "pool2", "min_nodes": 1, "max_nodes": 5}
]'
