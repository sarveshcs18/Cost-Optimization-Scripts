PROJECT_ID="hbl-uat-banking-ai-prj-4d"
REGION="asia-south1"
SERVICE_ACCOUNT="hbl-gcp-sa-cloud-schd-aibn-uat@hbl-srs-infosec-prj-spk-3c.iam.gserviceaccount.com"

# Application Specifics
APP_NAME="trade-app"
WORKFLOW_NAME="cost-opt-${APP_NAME}"
WORKFLOW_FILE="workflow.yaml"
TIMEZONE="Asia/Kolkata"

# Staggered Cron Schedules
# 1. Stop GKE at 11:00 PM
GKE_STOP_CRON="0 23 * * 1-5"
# 2. Stop VMs at 11:15 PM (giving GKE 15 mins to drain)
VM_STOP_CRON="15 23 * * 1-5"

# 3. Start VMs at 7:45 AM (DBs boot first)
VM_START_CRON="45 7 * * 1-5"
# 4. Start GKE at 8:00 AM (App connects to ready DBs)
GKE_START_CRON="0 8 * * 1-5"

# VM Targets
VM_LABEL_KEY="app"
VM_LABEL_VALUE="trade-app"

# GKE Targets
GKE_TARGETS='[
  {"cluster": "hbl-gcp-trd-gke-mumbai-uat1-cluster1", "nodepool": "trd-uat-mum-pool1", "min_nodes": 1, "max_nodes": 5}
]'
